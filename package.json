{
  "name": "digital-business-card",
  "version": "0.0.1",
  "description": "Цифровая визитка: GraphQL API на NestJS и Prisma",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/ prisma/ prisma.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --wait postgres",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "@apollo/server": {
      "@graphql-tools/utils": "^12.1.0"
    },
    "archiver-utils": {
      "glob": "^14.0.6"
    }
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^18.0.10",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
