# Пример настроек для локального запуска. Скопируйте в .env и при необходимости измените.

# Режим работы: development | test | production
NODE_ENV=development

# Порт HTTP-сервера
PORT=3000

# Строка подключения к PostgreSQL для запуска без Docker (npm run start:dev, миграции, seed).
# Пользователь, пароль, база и порт должны совпадать с настройками контейнера ниже.
DATABASE_URL=postgresql://card:card@localhost:5432/card

# Настройки контейнера PostgreSQL в docker-compose (значения по умолчанию — те же).
# POSTGRES_PORT — порт базы на этой машине, его открывает только docker-compose.dev.yml (npm run db:up).
# В пароле — только буквы и цифры: он подставляется в адрес базы без кодирования.
POSTGRES_USER=card
POSTGRES_PASSWORD=card
POSTGRES_DB=card
POSTGRES_PORT=5432

# Порт приложения на этой машине при запуске через docker compose
APP_PORT=3000

# Писать SQL-запросы в журнал: видно, сколько обращений к базе делает один запрос GraphQL
LOG_QUERIES=true

# Только для сервера (docker-compose.prod.yml): домен, для которого Caddy получает сертификат
# SITE_ADDRESS=card.example.com

# Только для сервера: порт HTTPS, если 443 занят другой службой. Тогда адрес сайта — https://домен:8443
# HTTPS_PORT=8443
