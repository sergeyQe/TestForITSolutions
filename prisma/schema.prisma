// Схема базы данных визитки. Адрес базы задаётся в prisma.config.ts, а не здесь.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Вид ссылки в профиле
enum LinkType {
  GITHUB
  TELEGRAM
  EMAIL
  HH
  LINKEDIN

  @@map("link_type")
}

/// Категория навыка
enum SkillCategory {
  LANGUAGES
  BACKEND
  DATA
  ARCHITECTURE
  DEVOPS
  TESTING

  @@map("skill_category")
}

/// Профиль специалиста. В базе один: это гарантирует seed
model Profile {
  id          Int    @id @default(autoincrement()) // первичный ключ
  name        String // ФИО одной строкой
  description String // текст «о себе»

  links       Link[] // ссылки профиля
  skills      Skill[] // навыки профиля
  experiences Experience[] // места работы
  projects    Project[] // проекты

  @@map("profiles")
}

/// Ссылка на профессиональный ресурс
model Link {
  id        Int      @id @default(autoincrement()) // первичный ключ
  profileId Int      @map("profile_id") // профиль-владелец
  type      LinkType // вид ссылки
  label     String // подпись для показа
  url       String // адрес: https://… или mailto:…
  sortOrder Int      @map("sort_order") // порядок показа: меньше — выше

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade) // связь с профилем: строка удаляется вместе с ним

  @@index([profileId])
  @@map("links")
}

/// Навык
model Skill {
  id        Int           @id @default(autoincrement()) // первичный ключ
  profileId Int           @map("profile_id") // профиль-владелец
  name      String // название навыка
  category  SkillCategory // категория навыка
  sortOrder Int           @map("sort_order") // сквозной порядок показа: меньше — выше

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade) // связь с профилем: строка удаляется вместе с ним

  @@index([profileId])
  @@map("skills")
}

/// Место работы. Даты — без времени, хранится первое число месяца; endDate = NULL — работает по настоящее время
model Experience {
  id        Int       @id @default(autoincrement()) // первичный ключ
  profileId Int       @map("profile_id") // профиль-владелец
  company   String // компания
  position  String // должность
  startDate DateTime  @map("start_date") @db.Date // начало работы: первое число месяца
  endDate   DateTime? @map("end_date") @db.Date // окончание: первое число месяца; NULL — работает сейчас
  sortOrder Int       @map("sort_order") // порядок показа: меньше — выше

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade) // связь с профилем: строка удаляется вместе с ним
  achievements Achievement[] // достижения на этом месте

  @@index([profileId])
  @@map("experiences")
}

/// Достижение на месте работы
model Achievement {
  id           Int    @id @default(autoincrement()) // первичный ключ
  experienceId Int    @map("experience_id") // место работы-владелец
  text         String // текст достижения
  sortOrder    Int    @map("sort_order") // порядок показа внутри места работы

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade) // связь с местом работы: строка удаляется вместе с ним

  @@index([experienceId])
  @@map("achievements")
}

/// Проект. Ссылки может не быть: исходники и сайты внутренних систем закрыты
model Project {
  id          Int     @id @default(autoincrement()) // первичный ключ
  profileId   Int     @map("profile_id") // профиль-владелец
  name        String // название проекта
  description String // что это за проект
  url         String? // ссылка; NULL — публичной ссылки нет
  sortOrder   Int     @map("sort_order") // порядок показа: меньше — выше

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade) // связь с профилем: строка удаляется вместе с ним

  @@index([profileId])
  @@map("projects")
}
