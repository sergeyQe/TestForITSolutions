# Пример настроек для локального запуска. Скопируйте в .env и при необходимости измените.

# Режим работы: development | test | production
NODE_ENV=development

# Порт HTTP-сервера
PORT=3000

# Строка подключения к PostgreSQL (значения совпадают с docker-compose.yml)
DATABASE_URL=postgresql://card:card@localhost:5432/card
